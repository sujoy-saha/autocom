# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Public/anon values used by the frontend only:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Nebius Token Factory (OpenAI-compatible inference API) ---
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_API_KEY=YOUR_NEBIUS_TOKEN_FACTORY_API_KEY
NEBIUS_MODEL=nvidia/nemotron-3-ultra

# --- Tavily (web search API) ---
# Used by the Replenishment Agent (real supplier leads on a vendor
# shortfall) and the ChatBot Agent (general Q&A fallback). Get a key at
# https://tavily.com/. Left unset, both features are skipped gracefully.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# --- Stripe (test-mode / sandbox payments) ---
# Used by the Payment Agent (backend/src/agents/paymentAgent.ts) to charge
# orders against Stripe's real test-mode sandbox instead of a simulated
# random approval. Use a *test* secret key only (sk_test_...), never a live
# key — get one at https://dashboard.stripe.com/test/apikeys. Left unset,
# the Payment Agent falls back to the original simulated ~90%-approval charge.
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
# Stripe test PaymentMethod IDs used for demoing outcomes
# (https://stripe.com/docs/testing#cards):
#   pm_card_visa            -> always succeeds
#   pm_card_chargeDeclined  -> always declines (generic_decline)
STRIPE_TEST_PAYMENT_METHOD=pm_card_visa
STRIPE_DECLINE_PAYMENT_METHOD=pm_card_chargeDeclined

# --- DSV (sandbox real carrier booking) ---
# Used by the Fulfillment Agent (backend/src/agents/fulfillmentAgent.ts) to
# book a real Road shipment via DSV's Connect Booking API sandbox instead of
# a simulated random carrier. Register at https://developer.dsv.com/,
# subscribe to the Booking API, and get approved for sandbox access to
# obtain these — only ever use *sandbox* credentials, never a production
# DSV account. Left unset, the Fulfillment Agent falls back to the original
# simulated shipment.
DSV_CLIENT_ID=YOUR_DSV_SANDBOX_CLIENT_ID
DSV_CLIENT_SECRET=YOUR_DSV_SANDBOX_CLIENT_SECRET
DSV_SUBSCRIPTION_KEY=YOUR_DSV_SANDBOX_SUBSCRIPTION_KEY
# MDM test account number issued with your sandbox subscription, used as
# both Booking Party and Freight Payer on every booking.
DSV_ACCOUNT_NUMBER=YOUR_DSV_TEST_ACCOUNT_NUMBER
DSV_TOKEN_URL=https://api.dsv.com/oauth2/token
DSV_API_BASE_URL=https://api-sandbox.dsv.com/connect/booking/v1

# Single fixed warehouse/sender address (hackathon simplification — this
# app has no multi-warehouse concept). Used as the shipper on every booking.
DSV_SENDER_NAME=AutoCom Warehouse
DSV_SENDER_STREET=Example Street 1
DSV_SENDER_CITY=Copenhagen
DSV_SENDER_ZIP=2100
DSV_SENDER_COUNTRY=DK
DSV_SENDER_PHONE=+45 00000000
DSV_SENDER_EMAIL=warehouse@example.com

# Default package weight/dimensions applied to every shipment (hackathon
# simplification — the catalog has no per-SKU weight/dimensions today).
DSV_DEFAULT_PACKAGE_WEIGHT_KG=5
DSV_DEFAULT_PACKAGE_LENGTH_CM=30
DSV_DEFAULT_PACKAGE_WIDTH_CM=20
DSV_DEFAULT_PACKAGE_HEIGHT_CM=15

# --- Backend server ---
PORT=4000

# --- Security hardening ---
# Comma-separated list of frontend origins allowed to call this API, e.g.
# https://your-app.vercel.app,http://localhost:3000 . Left unset, all
# origins are allowed (fine for local/demo use, not recommended once deployed).
ALLOWED_ORIGINS=http://localhost:3000

# --- Guardrails ---
# Orders whose total (EUR) exceeds this amount are held by the Approval Agent
# (status "pending_approval") until a human approves/rejects them in the
# dashboard, instead of proceeding straight to payment.
APPROVAL_THRESHOLD=500

# --- Replenishment Agent negotiation ---
# Max propose_restock_order back-and-forth rounds Nemotron will run per
# short SKU before it must finalize (or the agent falls back to a
# deterministic list-price place_restock_order). Only used when
# NEBIUS_API_KEY is set (demo mode is unaffected).
REPLENISHMENT_MAX_NEGOTIATION_ROUNDS=3

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
